# コンテナはホストの UID で動き、passwd にユーザーがないため、HOME を明示する。
# リポジトリのディレクトリを HOME にして、.claude/ や .bashrc などを残す
HOME=/api

UV_PROJECT_ENVIRONMENT=/api/venv
UV_CACHE_DIR=/tmp/uv-cache

WATCHFILES_FORCE_POLLING=true

# --- 必須 ---

# LLM(ChatOpenAI)の API キー
OPENAI_API_KEY=

# --- 任意(コメントアウトの値が未設定時の既定値。読み込みは api/config/settings.py) ---

# DB の接続先。compose の db コンテナ(db/init/ で作るユーザーと DB)に合わせてある
# DB_USER=developer
# DB_PASSWORD=password
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=api_dev

# 実行環境。local 以外では接続数のログ(ConcurrentConnections)を出す
# ENV=local

# 管理画面(/admin)のセッションの署名に使う秘密鍵
# ADMIN_SESSION_SECRET=sqladmin_secret

# プロンプトを DB(prompt_templates テーブル)に保存するか。ローカル開発用
# SAVE_PROMPT_TEMPLATE=false

# WebSocket の接続を開いておける最大時間(秒)
# WS_TIMEOUT_SECONDS=300

# 終了時に後処理(バックグラウンドタスク)の完了を待つ最大時間(秒)
# BACKGROUND_TASK_SHUTDOWN_TIMEOUT_SECONDS=30
